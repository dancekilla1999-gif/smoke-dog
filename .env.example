# Smoke Dog — переменные окружения
# Скопируйте в .env.local для разработки. На проде (Vercel) задайте в Project Settings → Environment Variables.

# --- Telegram: заявки с сайта (бронь стола + банкет) приходят в этот чат/бот ---
# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы/канала, куда бот будет слать заявки.
# Проще всего узнать: добавьте бота в группу, напишите любое сообщение,
# затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите "chat":{"id": ...}
TELEGRAM_CHAT_ID=

# --- Админ-панель (/admin) ---
ADMIN_EMAIL=admin@sdlounge.com
ADMIN_PASSWORD=
# Случайная строка для подписи сессионной cookie, напр.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Запись контента (content.json) из админки обратно в GitHub ---
GITHUB_REPO=dancekilla1999-gif/smoke-dog
GITHUB_TOKEN=

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=https://sdlounge.com
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Vercel Cron (еженедельный отчёт в Telegram) ---
CRON_SECRET=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
